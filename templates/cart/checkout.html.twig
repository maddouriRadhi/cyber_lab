{% extends 'base.html.twig' %}

{% block title %}Checkout — CyberLab{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('css/pricing.css') }}">
{% endblock %}

{% block body %}
<section class="price-hero">
  <div class="price-hero__card">
    <div class="price-kicker">Checkout</div>
    <h1 class="price-title">Pay with Card </h1>
    <p class="price-sub"></p>

    <div style="margin-top:14px; display:flex; gap:10px; flex-wrap:wrap;">
      <a class="plan__btn plan__btn--ghost" href="{{ path('app_cart') }}">← Back to cart</a>
    </div>
  </div>
</section>

<section class="price-grid" style="max-width:1100px; margin: 0 auto; padding: 0 18px; grid-template-columns: 1fr 420px;">
  <article class="plan">
    <div class="plan__top">
      <div class="plan__name">Order summary</div>
      <div class="plan__price">
        <span class="amount">${{ (total/100)|number_format(0) }}</span>
        <span class="per">total</span>
      </div>
      <p class="plan__desc">Items included:</p>
    </div>

    <ul class="plan__features">
      {% for l in lines %}
        <li>✅ {{ l.name }} — Qty {{ l.qty }} — ${{ (l.lineTotal/100)|number_format(0) }}</li>
      {% endfor %}
    </ul>
  </article>

  <article class="plan">
    <div class="plan__top">
      <div class="plan__name">Card details</div>
      <p class="plan__desc"></p>
    </div>

    <form method="post" action="{{ path('app_cart_checkout') }}">
      <input type="hidden" name="_token" value="{{ csrf_token('checkout_cart') }}">

      <div style="display:flex; flex-direction:column; gap:10px; margin-top:10px;">
        <input name="card_name" placeholder="Name on card" required
               style="padding:12px; border-radius:12px; border:1px solid rgba(255,255,255,.12); background: rgba(255,255,255,.04); color: rgba(255,255,255,.92);">

        <input name="card_number" placeholder="Card number (demo)" required
               style="padding:12px; border-radius:12px; border:1px solid rgba(255,255,255,.12); background: rgba(255,255,255,.04); color: rgba(255,255,255,.92);">

        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px;">
          <input name="card_exp" placeholder="MM/YY" required
                 style="padding:12px; border-radius:12px; border:1px solid rgba(255,255,255,.12); background: rgba(255,255,255,.04); color: rgba(255,255,255,.92);">
          <input name="card_cvc" placeholder="CVC" required
                 style="padding:12px; border-radius:12px; border:1px solid rgba(255,255,255,.12); background: rgba(255,255,255,.04); color: rgba(255,255,255,.92);">
        </div>

        <button class="plan__btn plan__btn--primary" type="submit">Pay ${{ (total/100)|number_format(0) }} </button>
        <div class="plan__desc" style="opacity:.8;"></div>
      </div>
    </form>
  </article>
</section>
{% endblock %}
