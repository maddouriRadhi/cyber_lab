{% extends 'base.html.twig' %}

{% block title %}Teacher Dashboard — CyberLab{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('css/admin.css') }}">
{% endblock %}

{% block body %}
<div class="dash">
  <section class="dash-hero">
    <div class="dash-hero__left">
      <div class="dash-kicker">Teacher Dashboard</div>

      <h1 class="dash-title">
        Welcome,
        <span class="dash-accent">{{ app.user ? app.user.userIdentifier : 'Teacher' }}</span>
      </h1>

      <p class="dash-sub">
        Manage labs, publish content, and help students learn.
      </p>

      <div class="dash-actions">
        <a class="dash-btn dash-btn--primary" href="{{ path('app_admin_labs') }}">Manage labs</a>
        <a class="dash-btn dash-btn--ghost" href="{{ path('app_labs') }}">View labs as student</a>
        <a class="dash-btn dash-btn--ghost" href="{{ path('app_learn') }}">Go to Learn</a>
      </div>
    </div>

    <div class="dash-hero__right">
      <div class="stat">
        <div class="stat__num">{{ publishedLabs }}</div>
        <div class="stat__label">Published labs</div>
      </div>
      <div class="stat">
        <div class="stat__num">{{ hiddenLabs }}</div>
        <div class="stat__label">Hidden labs</div>
      </div>
      <div class="stat">
        <div class="stat__num">{{ totalLabs }}</div>
        <div class="stat__label">Total labs</div>
      </div>
      <div class="stat stat--rank">
        <div class="stat__num">{{ totalSolves }}</div>
        <div class="stat__label">Total solves</div>
      </div>
    </div>
  </section>

  <section class="dash-section">
    <div class="dash-section__head">
      <div>
        <h2>Teacher actions</h2>
        <p>Quick shortcuts to your main tasks.</p>
      </div>
    </div>

    <div class="admin__grid">
      <a class="cardx" href="{{ path('app_admin_labs_new') }}">
        <div class="cardx__icon">➕</div>
        <div>
          <div class="cardx__title">Create a new Lab</div>
          <div class="cardx__text">Add title, flag, points, publish/unpublish.</div>
        </div>
        <div class="cardx__arrow">→</div>
      </a>

      <a class="cardx" href="{{ path('app_admin_labs') }}">
        <div class="cardx__icon">🧪</div>
        <div>
          <div class="cardx__title">Manage Labs</div>
          <div class="cardx__text">Edit, publish, hide, delete labs.</div>
        </div>
        <div class="cardx__arrow">→</div>
      </a>

      <a class="cardx" href="{{ path('app_admin_users') }}">
        <div class="cardx__icon">👥</div>
        <div>
          <div class="cardx__title">Users overview</div>
          <div class="cardx__text">See students/teachers and account status.</div>
        </div>
        <div class="cardx__arrow">→</div>
      </a>

      <a class="cardx" href="{{ path('app_admin_teachers') }}">
        <div class="cardx__icon">🧑‍🏫</div>
        <div>
          <div class="cardx__title">Teacher Applications</div>
          <div class="cardx__text">Review requests (if you allow teacher access later).</div>
        </div>
        <div class="cardx__arrow">→</div>
      </a>

      <div class="cardx cardx--info">
        <div class="cardx__icon">⚡</div>
        <div>
          <div class="cardx__title">Next easy upgrades</div>
          <div class="cardx__text">
            • “My labs only” (needs createdBy field)<br>
            • Publish queue / drafts<br>
            • Simple reports (most solved labs)
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
{% endblock %}
