{% extends 'base.html.twig' %}

{% block title %}Invoice #{{ order.id }} — CyberLab{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .inv{ max-width: 920px; margin: 18px auto; padding: 0 18px 26px; }
    .inv-card{ border: 1px solid rgba(255,255,255,.08); background: rgba(18,24,34,.35); backdrop-filter: blur(14px); border-radius: 18px; padding: 18px; }
    .inv-top{ display:flex; justify-content:space-between; gap:12px; align-items:flex-start; }
    .inv-h1{ margin:0; font-size:28px; }
    .inv-meta{ opacity:.8; margin-top:6px; font-size:13px; }
    .inv-table{ width:100%; border-collapse: collapse; margin-top: 14px; }
    .inv-table th, .inv-table td{ text-align:left; padding: 10px 10px; border-bottom: 1px solid rgba(255,255,255,.08); }
    .inv-total{ display:flex; justify-content:flex-end; margin-top: 12px; font-weight: 900; font-size: 18px; }
    @media print{
      .no-print{ display:none !important; }
      body{ background: #fff !important; color:#000 !important; }
      .inv-card{ background:#fff !important; border:1px solid #ddd !important; }
      .inv-table th, .inv-table td{ border-bottom: 1px solid #ddd !important; }
    }
  </style>
{% endblock %}

{% block body %}
<div class="inv">
  <div class="inv-card">
    <div class="inv-top">
      <div>
        <h1 class="inv-h1">Invoice #{{ order.id }}</h1>
        <div class="inv-meta">
          Date: {{ order.createdAt|date('Y-m-d H:i') }} • Status: {{ order.status }}
        </div>
        <div class="inv-meta">
          Customer: {{ order.user.email }}
        </div>
      </div>

      <div class="no-print" style="display:flex; gap:10px; flex-wrap:wrap;">
        <a class="plan__btn plan__btn--ghost" href="{{ path('app_cart') }}">← Back to cart</a>
        <button class="plan__btn plan__btn--primary" onclick="window.print()">Print / Save PDF</button>
      </div>
    </div>

    <table class="inv-table">
      <thead>
        <tr>
          <th>Item</th>
          <th>SKU</th>
          <th>Qty</th>
          <th>Unit</th>
          <th>Line</th>
        </tr>
      </thead>
      <tbody>
        {% for it in order.items %}
          <tr>
            <td>{{ it.name }}</td>
            <td>{{ it.sku }}</td>
            <td>{{ it.qty }}</td>
            <td>${{ (it.unitPriceCents/100)|number_format(0) }}</td>
            <td>${{ ((it.unitPriceCents*it.qty)/100)|number_format(0) }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>

    <div class="inv-total">
      Total: ${{ (order.totalCents/100)|number_format(0) }}
    </div>

    <div style="opacity:.75; font-size:12px; margin-top:10px;">
      Demo invoice for academic project (no real payment).
    </div>
  </div>
</div>
{% endblock %}
